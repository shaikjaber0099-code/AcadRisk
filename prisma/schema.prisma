generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    // "STUDENT", "TEACHER", "ADMIN"
  studentId    String?   @unique
  student      Student?  @relation(fields: [studentId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Student {
  id                   String               @id @default(cuid())
  rollNo               String               @unique
  name                 String
  email                String               @unique
  classId              String               // "CS-A", "CS-B", "CS-C"
  attendance           Float                // 0 - 100%
  weeklyStudyHours     Float                // 0 - 40 hours
  assignmentCompletion Float                // 0 - 100%
  previousGpa          Float                // 0 - 10
  backlogs             Int                  // 0 - 10
  participation        Float                // 1 - 5
  lateSubmissions      Int                  // 0 - 20
  
  // JSON stringified subjects with 3 internal marks each
  internalMarksJson    String               

  // Cached calculated metrics from engine
  currentScore         Float                // 0 - 100
  predictedScore       Float                // 0 - 100
  riskLevel            String               // "LOW", "MEDIUM", "HIGH"
  earlyWarning         Boolean              @default(false)
  earlyWarningReasons  String               @default("[]") // JSON string array
  trendSlope           Float                @default(0)
  trendDirection       String               @default("stable") // "improving", "declining", "stable"
  
  // Relationships
  monthlyHistory       PerformanceHistory[]
  user                 User?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model PerformanceHistory {
  id         String   @id @default(cuid())
  studentId  String
  monthIndex Int      // 1 to 6
  monthName  String   // "Aug", "Sep", "Oct", "Nov", "Dec", "Jan"
  score      Float
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, monthIndex])
}
